{
  "name": "fs-router-cloudflare",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "waku dev",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "pretypecheck": "wrangler types",
    "typecheck": "tsc --noEmit",
    "build": "waku build",
    "check": "npm run test && npm run typecheck && npm run build",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "hono": "^4.12.31",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "react-server-dom-webpack": "~19.2.8",
    "waku": "1.0.0-beta.9",
    "wrangler": "^4.113.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.46.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "29.0.1",
    "miniflare": "^4.20260721.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
